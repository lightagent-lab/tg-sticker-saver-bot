# 复制为 .env 后填写。不要把真实 .env 提交到 Git。

# 从 @BotFather 获取的机器人 Token
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 管理员 Telegram 数字 ID（用于接收每日统计、放宽队列限制）
# 用 @userinfobot 或 /start 后查看日志获取
ADMIN_ID=000000000

# 机器人显示名称，出现在欢迎语和每日统计里
BOT_NAME=表情包保存bot

# 可选的欢迎语开场白，留空则不显示
BOT_TAGLINE=又来收藏表情包啦？真拿你没办法喵。

# 管理员用户名（不带 @），展示在欢迎语和 ZIP 内的说明里，可留空
ADMIN_USERNAME=

# 语言：zh 或 en
BOT_LANG=zh

# 时区偏移（小时），每日统计按此时间发送，默认北京时间
REPORT_HOUR=0
REPORT_MINUTE=5
